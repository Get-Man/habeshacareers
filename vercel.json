{
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/", "destination": "https://habeshacareers.vercel.app/", "permanent": true },
    { "source": "/index.html", "destination": "https://habeshacareers.vercel.app/", "permanent": true },
    { "source": "/login.html", "destination": "https://habeshacareers.vercel.app/login", "permanent": true },
    { "source": "/jobs.html", "destination": "https://habeshacareers.vercel.app/jobs", "permanent": true },
    { "source": "/job-details.html", "destination": "https://habeshacareers.vercel.app/jobs", "permanent": true },
    { "source": "/job/:id/:slug", "destination": "https://habeshacareers.vercel.app/jobs/:id", "permanent": true },
    { "source": "/job/:id", "destination": "https://habeshacareers.vercel.app/jobs/:id", "permanent": true },
    { "source": "/dashboard.html", "destination": "https://habeshacareers.vercel.app/dashboard", "permanent": true },
    { "source": "/account.html", "destination": "https://habeshacareers.vercel.app/account", "permanent": true },
    { "source": "/post-job.html", "destination": "https://habeshacareers.vercel.app/post-job", "permanent": true },
    { "source": "/admin.html", "destination": "https://habeshacareers.vercel.app/admin", "permanent": true },
    { "source": "/about.html", "destination": "https://habeshacareers.vercel.app/", "permanent": true },
    { "source": "/contact.html", "destination": "https://habeshacareers.vercel.app/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/sitemap?type=robots" }
  ],
  "crons": [
    { "path": "/api/cron/sync-jobs", "schedule": "0 6 * * *" },
    { "path": "/api/cron/extract-jobs", "schedule": "0 18 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/admin/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/api/cron/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
