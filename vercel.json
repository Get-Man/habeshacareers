{
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/cron/sync-jobs",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
